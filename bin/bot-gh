#!/usr/bin/env bash
# bot-gh: run `gh` as the Claude GitHub App of the harness routines, so
# comments, reviews, issues and PRs show the app (<name>[bot]) as author.
#
# Config: <secrets_dir>/bot.env (chmod 600) with
#   APP_ID=123456
#   KEY_FILE=<secrets_dir>/app.pem
#   INSTALLATION_ID=...   (optional, looked up from the repo when empty)
# Exit 3 = not configured: the caller must not fall back to the personal gh login.
# The token is passed to gh through the environment only and never printed.
set -euo pipefail

# shellcheck source=../lib/harness.sh
. "$(dirname "$0")/../lib/harness.sh"
repo=${HARNESS_BOT_REPO:-$(hconf repo)} || exit 3
conf=${HARNESS_BOT_CONF:-$(hconf secrets_dir)/bot.env} || exit 3

# Refuse to post private infrastructure details. What gets scanned is what GitHub would receive: the
# arguments, plus the content of every local file gh is told to send. gh reads such a file through
# --body-file / -F (issue, pr), and through --input and fields whose value starts with @
# (-F / --field key=@file) with api. Each of these files is copied into a private temporary folder: the
# copy is scanned and gh is given the copy, so the text checked is exactly the text sent, and the local
# path (it holds the user name) never leaves the machine. Every other way for gh to read local text is
# refused: stdin, --recover, --template, --editor, pr create --fill, a short flag that reads a file
# bundled with other letters (-aF), api placeholders gh fills from local git ({owner}, :repo, {branch}...),
# and every command but api, issue, pr and label (release assets, gists...).
# Every argument is checked as a possible flag, `--` included: gh takes `--` as the value of the flag
# before it (-t -- -F file) and keeps reading flags. A file name taken as a flag's value must not start
# with `-`, so gh cannot read it as a flag that bot-gh skipped. Exit 4 = refused, nothing sent.
refuse() { echo "bot-gh: refused: $*" >&2; exit 4; }
cmd=${1:-} vals=''
case $cmd in
    api)   risky=F vals=fHXqtp ;;  # -F (a field, which may be @file); vals: the short flags that take a value
    issue) risky=FTe ;;            # -F body file, -T template, -e editor
    pr)    risky=FTef ;;           # the same, and -f (create --fill: commit messages)
    label) risky='' ;;
    *) refuse "bot-gh runs only gh api, issue, pr and label (other commands can send local files unchecked)" ;;
esac
tmp=$(mktemp -d -t bot-gh.XXXXXX) || refuse "cannot create a temporary folder"
trap 'rm -rf "$tmp"' EXIT
trap 'exit 130' INT TERM HUP
copies=() out=() shown=() n=0 copy='' value='' seen=''
take() {  # take FILE: copy a file gh would send and set $copy to the copy's path
    [[ -n $1 && $1 != - ]] || refuse "pass text as a file, not on stdin, so it can be checked"
    [[ $1 != -* ]] || refuse "a file name must not start with - (gh could read it as a flag): write ./$1"
    [[ -f $1 && -r $1 ]] || refuse "cannot read a file given to gh (it must be a regular, readable file)"
    n=$((n + 1)) copy=$tmp/$n
    cp -- "$1" "$copy" || refuse "cannot copy a file given to gh"
    copies+=("$copy")
}
field() {  # field KEY=VALUE (api -F): gh reads a value starting with @ from a file. Sets $value (for gh), $seen (scanned)
    [[ $1 != -* ]] || refuse "a field must be key=value, not a flag ($1)"
    placeholders "$1"
    value=$1 seen=$1
    if [[ $1 == *=* && ${1#*=} == @* ]]; then
        take "${1#*=@}"; value=${1%%=*}=@$copy seen=${1%%=*}=@FILE
    fi
}
placeholders() {  # gh api fills {owner} / :owner, {repo} / :repo and {branch} / :branch from local git after the check.
    # A plain substring match, whatever follows (:branché too): no regex, so the locale cannot change the answer.
    if [[ $cmd == api && ( $1 == *\{owner\}* || $1 == *\{repo\}* || $1 == *\{branch\}* ||
                           $1 == *:owner* || $1 == *:repo* || $1 == *:branch* ) ]]; then
        refuse "write the repository and branch out: gh fills {owner}, {repo}, {branch} (and :owner, :repo, :branch) from local git"
    fi
}
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    a=${args[i]}
    placeholders "$a"
    case $cmd:$a in
        *:--body-file|*:--body-file=*|api:--input|api:--input=*)
            if [[ $a == *=* ]]; then take "${a#*=}"; else i=$((i + 1)); take "${args[i]:-}"; fi
            out+=("${a%%=*}" "$copy"); shown+=("${a%%=*}" FILE); continue ;;
        api:-F|api:--field|api:-F?*|api:--field=*)
            if [[ $a == -F || $a == --field ]]; then i=$((i + 1)); field "${args[i]:-}"
            elif [[ $a == --field=* ]]; then field "${a#*=}"
            else a=${a#-F}; field "${a#=}"; fi                     # -Fkey=@file or -F=key=@file
            out+=(-F "$value"); shown+=(-F "$seen"); continue ;;
        api:*) ;;
        *:-F|*:-F?*)                                               # -F file, -Ffile or -F=file
            if [[ $a == -F ]]; then i=$((i + 1)); take "${args[i]:-}"; else a=${a#-F}; take "${a#=}"; fi
            out+=(-F "$copy"); shown+=(-F FILE); continue ;;
        *:--recover|*:--recover=*|*:--template|*:--template=*|*:--editor|*:--editor=*|pr:--fill*)
            refuse "${a%%=*} makes gh post text bot-gh cannot check: use --body-file" ;;
    esac
    # Short flags bundled in one argument (-aF, -iFkey=@file): gh reads letters until one takes a value.
    # A letter that reads local text must stand alone (-F <file>); -T, -e and pr -f are refused outright.
    if [[ -n $risky && $a == -[!-]* ]]; then
        for ((j = 1; j < ${#a}; j++)); do
            l=${a:j:1}
            if [[ $l == ["$risky"] ]]; then
                refuse "-$l reads local text bot-gh cannot check: write -F <file> on its own, or use --body-file"
            fi
            [[ -n $vals && $l == ["$vals"] ]] && break               # the rest of the argument is this flag's value
        done
    fi
    out+=("$a"); shown+=("$a")
done
printf '%s\n' ${shown[@]+"${shown[@]}"} > "$tmp/args"
for f in "$tmp/args" ${copies[@]+"${copies[@]}"}; do    # one by one: a pattern cannot hide across two files
    "$(dirname "$0")/scan-private" "$f" || exit $?
done

if [[ ! -r $conf ]]; then
    echo "bot-gh: not configured ($conf missing)" >&2
    exit 3
fi
APP_ID='' KEY_FILE='' INSTALLATION_ID=''
# shellcheck disable=SC1090
source "$conf"
if [[ -z $APP_ID || ! -r $KEY_FILE ]]; then
    echo "bot-gh: not configured (APP_ID or KEY_FILE missing in $conf)" >&2
    exit 3
fi

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$APP_ID" | b64url)
signature=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$KEY_FILE" -binary | b64url)
jwt="$header.$payload.$signature"

api() {
    curl -fsS -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" "$@"
}

if [[ -z $INSTALLATION_ID ]]; then
    INSTALLATION_ID=$(api "https://api.github.com/repos/$repo/installation" | jq -r .id)
fi
token=$(api -X POST "https://api.github.com/app/installations/$INSTALLATION_ID/access_tokens" | jq -r .token)
if [[ -z $token || $token == null ]]; then
    echo "bot-gh: could not get an installation token for $repo" >&2
    exit 1
fi

# not exec: the temporary copies are removed when gh is done
rc=0
GH_TOKEN=$token gh "${out[@]}" || rc=$?
exit "$rc"
